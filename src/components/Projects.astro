---
/*
  src/components/Projects.astro

  每个区块使用 flex 布局，图片全部用相同的纵横比容器 (aspect-video + object-cover)，
  保证视觉效果整齐有序。
*/
---

<section
  class="relative w-full max-w-screen-2xl mx-auto flex flex-col items-center gap-12 px-4 py-24 select-none"
>
  <!-- 大标题 + 副标题 -->
  <div class="w-full max-w-3xl text-center">
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-medium tracking-tight text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground mb-4"
    >
      Every family deserves a real, accessible AAC solution.
    </h2>
    <p class="text-base sm:text-lg md:text-xl text-muted-foreground font-light">
      No sales pressure. No markup. Just support, honesty and real choice.
    </p>
  </div>

  <!-- 1. 设备套餐展示 -->
  <div
    class="w-full bg-dark-card rounded-2xl border border-dark-border overflow-hidden shadow-lg flex flex-col lg:flex-row gap-6 p-6"
  >
    <!-- 左侧文字 -->
    <div class="flex-1 flex flex-col justify-center text-left">
      <h3
        class="text-xl sm:text-2xl md:text-3xl font-medium tracking-tight text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary mb-3"
      >
        The AAC For All Device Kit
      </h3>
      <p class="text-sm sm:text-base md:text-lg text-muted-foreground leading-relaxed">
        Rugged Samsung Galaxy Tab Active 3 tablet, new shockproof case (with hand/shoulder straps), and pre-installed screen protector.
        <br /><br />
        Suited for non-speaking or autistic children — durable, portable, ready for real-life use at home, school, or in the community.
      </p>
    </div>
    <!-- 右侧图片 -->
    <div class="flex-1 aspect-video min-w-[200px] max-w-sm overflow-hidden rounded-lg bg-black">
      <img
        src="/assets/aac-1.jpg"
        alt="Tablet and case"
        loading="lazy"
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- 2. 特色标签区 -->
  <div
    class="w-full bg-dark-card rounded-2xl border border-dark-border overflow-hidden shadow-lg flex flex-wrap justify-center gap-4 px-6 py-8"
  >
    <span
      class="px-4 py-2 bg-background text-sm sm:text-base font-medium rounded-full shadow-sm"
    >
      Free open-source AAC apps
    </span>
    <span
      class="px-4 py-2 bg-background text-sm sm:text-base font-medium rounded-full shadow-sm"
    >
      No Google account required
    </span>
    <span
      class="px-4 py-2 bg-background text-sm sm:text-base font-medium rounded-full shadow-sm"
    >
      Instant trial, full refund
    </span>
    <span
      class="px-4 py-2 bg-background text-sm sm:text-base font-medium rounded-full shadow-sm"
    >
      Companion Card supported
    </span>
  </div>

  <!-- 3. 应用截图展示 -->
  <div
    class="w-full bg-dark-card rounded-2xl border border-dark-border overflow-hidden shadow-lg flex flex-col lg:flex-row gap-6 p-6"
  >
    <div class="flex-1 aspect-video min-w-[200px] max-w-sm overflow-hidden rounded-lg bg-black">
      <img
        src="/assets/aac-2.jpeg"
        alt="AAC app running"
        loading="lazy"
        class="w-full h-full object-cover object-center"
      />
    </div>
    <div class="flex-1 aspect-video min-w-[200px] max-w-sm overflow-hidden rounded-lg bg-black">
      <img
        src="/assets/aac-3.png"
        alt="Tablet with accessories"
        loading="lazy"
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- 4. 定价及退款政策展示 -->
  <div
    class="w-full bg-dark-card rounded-2xl border border-dark-border overflow-hidden shadow-lg flex flex-col lg:flex-row gap-6 p-6"
  >
    <!-- 左侧文字 -->
    <div class="flex-1 flex flex-col justify-center text-left">
      <h3
        class="text-xl sm:text-2xl md:text-3xl font-medium tracking-tight text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary mb-3"
      >
        Fair, transparent, parent-driven
      </h3>
      <p class="text-sm sm:text-base md:text-lg text-muted-foreground leading-relaxed">
        Each set is offered at cost: <strong>$110</strong> (with valid Companion Card).
        <br /><br />
        <strong>Try for 2 weeks — if it's not the right fit, just return for a full refund. No questions asked.</strong>
        <br />
        This is about support, not sales.
      </p>
    </div>
    <!-- 右侧图片 -->
    <div class="flex-1 aspect-video min-w-[200px] max-w-sm overflow-hidden rounded-lg bg-black">
      <img
        src="/assets/aac-4.jpg"
        alt="Protective case set"
        loading="lazy"
        class="w-full h-full object-cover object-center"
      />
    </div>
  </div>

  <!-- 5. 联系方式区 -->
  <div
    class="w-full bg-dark-card rounded-2xl border border-dark-border overflow-hidden shadow-lg flex flex-col justify-center items-center gap-4 p-8"
  >
    <h3
      class="text-xl sm:text-2xl md:text-3xl font-medium tracking-tight text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
    >
      Questions? Contact me
    </h3>
    <a
      href="mailto:helloluna520@gmail.com"
      class="inline-block px-6 py-3 bg-primary text-white font-medium rounded-lg shadow hover:bg-opacity-90 transition-colors"
    >
      📧 Email for support
    </a>
  </div>
</section>

<style>
  /* 保证所有 <img> 都在 16:9 容器内裁切，保持一致 */
  .aspect-video {
    aspect-ratio: 16 / 9;
  }
</style>
