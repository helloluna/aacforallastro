---
import Layout from "../../layouts/Layout.astro";

const files = [
  {
    name: "Cboard AAC 1.33.0",
    path: "/apk/Cboard_AAC_1.33.0.apk",
  },
  {
    name: "JABtalk 5.3.2",
    path: "/apk/JABtalk_5.3.2.apk",
  },
  {
    name: "Jellow Basic AAC Communicator 4.1.2",
    path: "/apk/Jellow_Basic_AAC_Communicator_4.1.2.apk",
  },
  {
    name: "LetMeTalk 1.4.29",
    path: "/apk/LetMeTalk_1.4.29.apk",
  },
];
---

<Layout
  title="Download Free AAC Apps – AAC For All"
  description="Free, open-source AAC APK downloads for Android tablets. No Google Play needed. Curated apps for non-speaking children and autistic users."
  ogImage="/assets/aac-3.png"
  canonical="https://aacforall.org/apk"
>
  <main class="bg-gray-100 min-h-screen pb-16">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-indigo-600 py-20">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">
          🎁 Download Free AAC Apps (APK)
        </h1>
        <p class="text-lg md:text-xl text-blue-100">
          Curated, open-source AAC applications for Android tablets.
          <br class="hidden sm:block" />
          No Google Play needed—just click to download the APK.
        </p>
      </div>
    </section>

    <!-- APK List Section -->
    <section class="max-w-3xl mx-auto mt-[-4rem] px-4">
      <div class="bg-white shadow-xl rounded-lg overflow-hidden">
        <ul class="divide-y divide-gray-200">
          {files.map((f) => (
            <li
              class="flex flex-col md:flex-row items-center justify-between p-6 hover:bg-gray-50 transition-colors"
            >
              <div class="flex items-center space-x-4 w-full md:w-3/4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 text-blue-500 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                <span class="text-lg font-medium text-gray-800">{f.name}</span>
              </div>
              <div class="mt-4 md:mt-0">
                <a
                  href={f.path}
                  download
                  class="inline-block px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition-colors"
                  aria-label={`Download ${f.name} APK`}
                >
                  Download
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PDF Guides Section -->
    <section class="max-w-3xl mx-auto mt-12 px-4">
      <div class="flex flex-col md:flex-row items-center justify-center space-y-4 md:space-y-0 md:space-x-6">
        <a
          href="/assets/AAC_App_Installation_Guide.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center space-x-2 px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg shadow hover:bg-indigo-700 transition-colors"
        >
          📖
          <span>AAC App Installation Guide (PDF)</span>
        </a>

        <a
          href="/assets/How_to_Pin_App_Samsung_Tab_Active3.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center space-x-2 px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg shadow hover:bg-indigo-700 transition-colors"
        >
          🔒
          <span>How to Pin an App (PDF)</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
