---
import Layout from "../../layouts/Layout.astro";

const files = [
  {
    name: "Cboard AAC 1.33.0",
    path: "/apk/Cboard_AAC_1.33.0.apk",
  },
  {
    name: "JABtalk 5.3.2",
    // NOTE: If your filename contains spaces, make sure the actual file on disk is URL-safe
    // (e.g. “JABtalk_5.3.2.apk” rather than “JABtalk 5.3.2.apk”), or URL-encode the spaces here:
    // path: "/apk/JABtalk%205.3.2.apk"
    path: "/apk/JABtalk_5.3.2.apk",
  },
  {
    name: "Jellow Basic AAC Communicator 4.1.2",
    path: "/apk/Jellow_Basic_AAC_Communicator_4.1.2.apk",
  },
  {
    name: "LetMeTalk 1.4.29",
    path: "/apk/LetMeTalk_1.4.29.apk",
  },
];
---

<Layout title="Download Free AAC Apps – AAC For All">
  <main class="max-w-screen-md mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6 text-center">
      🎁 Download Free AAC Apps (APK)
    </h1>
    <p class="text-center text-gray-600 mb-8">
      Here are our curated open-source AAC apps. No Google Play needed—just click to download the APK for your Android tablet:
    </p>

    <ul class="space-y-4 list-disc list-inside text-lg">
      {files.map((f) => (
        <li>
          <a
            class="text-blue-600 hover:underline"
            href={f.path}
            download
          >
            {f.name}
          </a>
          <span class="text-gray-500"> &mdash; Click to download APK</span>
        </li>
      ))}
    </ul>

    <div class="mt-10 text-center">
      <a
        class="inline-block px-6 py-3 bg-blue-600 text-white font-medium rounded-lg shadow hover:bg-blue-700 transition-colors"
        href="/assets/AAC_App_Installation_Guide.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        📖 AAC App Installation Guide (PDF)
      </a>
      <span class="mx-4 text-gray-400">|</span>
      <a
        class="inline-block px-6 py-3 bg-blue-600 text-white font-medium rounded-lg shadow hover:bg-blue-700 transition-colors"
        href="/assets/How_to_Pin_App_Samsung_Tab_Active3.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        🔒 How to Pin an App (PDF)
      </a>
    </div>
  </main>
</Layout>
