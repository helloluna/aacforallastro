---
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import Stack from "@/components/Stack.astro";
import Projects from "@/components/Projects.astro";
import About from "@/components/About.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="AAC For All – Free Android AAC Apps & Affordable Tablets"
  description="AAC For All offers free open-source communication apps and low-cost Android AAC tablets. A parent-led, nonprofit project for non-speaking and autistic children."
  ogImage="/assets/hero-bg.jpg"
  canonical="https://aacforall.org"
>
  <main
    class="relative w-full flex flex-col justify-start items-center pattern"
  >
    <!-- Main site title for SEO -->
    <h1 class="sr-only">
      AAC For All – Free Android AAC Apps & Affordable Tablets for Non-Speaking Children
    </h1>

    <Header />
    <Hero />
    <Stack />
    <Projects />
    <About />
    <Footer />
  </main>
</Layout>

<style>
  .pattern {
    background-color: #ffffff;
    background-image: radial-gradient(circle at top center, #f5fdff 70px, white),
      repeating-radial-gradient(
        circle at top center,
        #ffffff,
        #ffffff,
        200px,
        transparent 0,
        #eaeaea 201px
      );
    background-blend-mode: multiply;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
