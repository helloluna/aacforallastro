---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import AboutComponent from "../components/About.astro";

---

<Layout
  title="About – AAC For All"
  description="Learn more about AAC For All, a nonprofit project by a parent of two autistic children. We provide free open-source AAC apps and affordable communication devices."
  ogImage="/assets/aac-7.png"
  canonical="https://aacforall.org/about"
>
  <main class="max-w-screen-md mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6 text-center">
      About AAC For All
    </h1>
    <Header />
    <AboutComponent />
  </main>
</Layout>
