---
// src/pages/apk/index.astro
// 这只是一个示例页面，把它放在 src/pages/apk/ 里就能对应到 /apk/ 路由。
const files = [
  { name: "Cboard AAC 1.33.0", path: "/apk/Cboard_AAC_1.33.0.apk" },
  { name: "JABtalk 5.3.2",    path: "/apk/JABtalk 5.3.2.apk" },
  { name: "Jellow AAC 4.1.2", path: "/apk/Jellow Basic AAC Communicator_4.1.2.apk" },
  { name: "LetMeTalk 1.4.29",  path: "/apk/LetMeTalk 1.4.29.apk" }
];
---

<Layout title="Download Free AAC Apps">
  <main class="max-w-screen-md mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6">下载免费 AAC 应用</h1>
    <ul class="space-y-4">
      {files.map((f) => (
        <li>
          <a class="text-blue-600 hover:underline" href={f.path} download>
            {f.name}
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
